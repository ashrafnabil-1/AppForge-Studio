{
  "name": "appforge-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run src && node --test tools/generator.test.mjs tools/web-generator.test.mjs",
    "test:watch": "vitest",
    "test:generator": "node --test tools/generator.test.mjs tools/web-generator.test.mjs",
    "generate:flutter": "node tools/generate-flutter.mjs",
    "generate:web": "node tools/generate-web.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "~5.7.2",
    "vitest": "^2.1.8",
    "jsdom": "^25.0.1"
  }
}
